{
  "name": "@zeroshift/backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "seed": "tsx src/cli.ts generate",
    "seed:small": "tsx src/cli.ts generate --customers=1000 --orders=5000",
    "seed:medium": "tsx src/cli.ts generate --customers=20000 --orders=100000",
    "seed:large": "tsx src/cli.ts generate --customers=100000 --orders=500000",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "fastify": "^5.2.0",
    "mssql": "^11.0.1",
    "pg": "^8.13.1",
    "pg-copy-streams": "^7.0.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.11",
    "@types/pg-copy-streams": "^1.2.5",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
