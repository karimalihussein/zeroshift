{
  "uid": "zeroshift-resilience",
  "title": "ZeroShift resilience lab",
  "schemaVersion": 41,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "zeroshift"
  ],
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "Clients: arrivals and requests sent (/s)",
      "description": "Open-loop arrivals vs every attempt sent. A gap is retries: a retry storm is this gap widening.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(zeroshift_load_attempts_total[30s]))",
          "legendFormat": "requests sent"
        },
        {
          "refId": "B",
          "expr": "sum(rate(zeroshift_load_latency_seconds_count[30s]))",
          "legendFormat": "requests OK"
        },
        {
          "refId": "C",
          "expr": "rate(zeroshift_load_dropped_total[30s])",
          "legendFormat": "turned away at cap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Client latency, successful writes",
      "description": "Client-observed, retries included.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(zeroshift_load_latency_seconds_bucket{kind=\"write\"}[30s])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(zeroshift_load_latency_seconds_bucket{kind=\"write\"}[30s])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(zeroshift_load_latency_seconds_bucket{kind=\"write\"}[30s])))",
          "legendFormat": "p99"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(zeroshift_load_latency_seconds_bucket{kind=\"read\"}[30s])))",
          "legendFormat": "read p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Consumer lag (records)",
      "description": "What each consumer still has to read.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (kafka_consumer_fetch_manager_records_lag)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Client attempts by outcome (/s)",
      "description": "Failures by cause as clients see them: timeouts, refused connections, 5xx, 429, 503.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(zeroshift_load_attempts_total{outcome!=\"OK\"}[30s]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Edge admissions, POST /orders (/s)",
      "description": "What the rate limiter, load shedder and bulkhead admitted or refused, both replicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(zeroshift_edge_requests_total[30s]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Unfinished orders and requests in flight",
      "description": "Sagas placed but not finished (the shedder's signal) and POST /orders being handled.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(zeroshift_saga_active)",
          "legendFormat": "unfinished orders"
        },
        {
          "refId": "B",
          "expr": "sum(zeroshift_edge_in_flight)",
          "legendFormat": "in flight"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Consumer decisions (/s)",
      "description": "Processed, redelivery scheduled, duplicate skipped, dead-lettered, across services.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision) (rate(zeroshift_consumer_decisions_total[30s]))",
          "legendFormat": "{{decision}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Gateway attempts by outcome (/s) and breaker",
      "description": "Every attempt payment-service made; breaker open = 1.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(zeroshift_gateway_attempts_total[30s]))",
          "legendFormat": "{{outcome}}"
        },
        {
          "refId": "B",
          "expr": "max(resilience4j_circuitbreaker_state{state=\"open\"})",
          "legendFormat": "breaker open"
        },
        {
          "refId": "C",
          "expr": "increase(zeroshift_gateway_consumer_pauses_total[1m])",
          "legendFormat": "consumer pauses"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Threads waiting for a DB connection",
      "description": "Hikari pending per service: a saturated pool.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (hikaricp_connections_pending)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Process CPU",
      "description": "Share of the container's CPUs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "id": 10
    }
  ]
}