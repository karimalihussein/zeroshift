{
  "name": "zeroshift",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm test -w backend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "lint": "npm run lint -w backend && npm run lint -w frontend && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "npm run seed -w backend --",
    "seed:small": "npm run seed:small -w backend",
    "seed:medium": "npm run seed:medium -w backend",
    "seed:large": "npm run seed:large -w backend",
    "lab:status": "npm run cli -w backend -- status",
    "data:generate": "npm run cli -w backend -- generate",
    "traffic:start": "npm run cli -w backend -- traffic-start",
    "migrate:start": "npm run cli -w backend -- migrate-start",
    "migrate:resume": "npm run cli -w backend -- migrate-resume",
    "validate": "npm run cli -w backend -- validate",
    "cutover": "npm run cli -w backend -- cutover",
    "lab:reset": "npm run cli -w backend -- reset"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
